# TSecBench 运行期环境变量（平台「运行时环境变量」导入用）
# BENCHMARK_TOKEN / BENCHMARK_BASE_URL 由平台自动注入，不在此列。
# 注意：本文件不含真实密钥，LLM_API_KEY 请在你本机填写后导入平台。

# ---- 必填 ----
LLM_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
GATEWAY_MODE=on

# ---- 时空调优（决赛窗口实测值）----
CONCURRENCY_LIMIT=3
SLICE_MIN_S=300
SLICE_MAX_S=1800
TOTAL_TIME_LIMIT=21600
RESERVE_SECONDS=600
API_MAX_QPS=3

# ---- 优化开关 ----
# v2 控制面尚未实机验证，正式跑保持关闭
HARNESS_V2=off
# 攻击图记忆（triviumdb 缺失自动降级，安全）
MEMORY_TDB=on
# hard/失败题自动升档用的攻坚模型
SOLVER_REASONER_MODEL=deepseek-reasoner
