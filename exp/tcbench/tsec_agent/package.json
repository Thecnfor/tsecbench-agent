{
  "name": "@tsecbench/tsec-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TSec Benchmark 自动跑分 agent（Node 26 + TS 重写；单 shell 工具、分段解题、React 观察面板）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:panel && pnpm build:agent",
    "build:agent": "vite build --config vite.node.config.ts",
    "build:panel": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node dist/panel-server.js",
    "dev": "vite"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
