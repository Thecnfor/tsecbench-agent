# ─────────────────────────────────────────────────────────────────────────────
# 工具链版本唯一真值源（image-spec.md §3.1）
# 任何构建脚本 / Dockerfile 不得另写版本号，一律 source 本文件或读取对应值。
# 改版本 = 改这里 + 重跑受影响的自检。
# ─────────────────────────────────────────────────────────────────────────────

# L0/L1 —— Python 3.14（下限由 ctf-agent requires-python 硬定；3.15 排除，见 architecture.md §1.1）
PYTHON_VERSION=3.14

# L2 —— Go（自研 recorder + 现成静态工具；仅构建期，runtime 不留工具链）
GO_VERSION=1.26

# L3 —— Node（精确小版本钉死；10/16 彩排若异常按 B12 切 24，只改此处 + Dockerfile）
NODE_VERSION=26.8.1

# L3 —— REA（rea-agents，npm；churn 极快必须钉死，绝不写 ^6）
REA_VERSION=6.3.0

# L1 执行内核 —— pi coding agent（npm；dual_main.py / Dockerfile 只读此处）
PI_PACKAGE=@earendil-works/pi-coding-agent
PI_VERSION=1.1.0

# L1.5 TS 手动工作流层 —— Mastra（npm；solver/ts-workflow 只读此处）
MASTRA_VERSION=1.75.0
ZOD_VERSION=4.6.5

# 逆向面
GHIDRA_VERSION=12.1.4
JDK_VERSION=21

# L4 —— Lua（仅本地自检 NSE；不装 luarocks）
LUA_VERSION=5.4

# Rust 系静态二进制（按 GitHub release tag 下载 + sha256 校验；构建镜像前在此落定）
RIPGREP_VERSION=TODO-PIN-AT-IMAGE-BUILD
FEROXBUSTER_VERSION=TODO-PIN-AT-IMAGE-BUILD

# 平台网关（Gateway Rewriter 唯一后缀，architecture.md §6.2）
GATEWAY_SUFFIX=.tsecbench.gw
